    else if(Math.abs(dx)>Math.abs(dy)) dx>0 ? sendCmd('R','DERECHA') : sendCmd('L','IZQUIERDA');
    else dy>0 ? sendCmd('B','ATRÁS') : sendCmd('F','ADELANTE');
  }

