// ===== FUNCIONES DE MOTORES (MÁXIMA POTENCIA REAL CON DIGITALWRITE) =====
void frenarMotores() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, LOW);
  Serial.println("FRENADO");
}

void avanzar() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("AVANZANDO (POTENCIA MAX)");
}

void retroceder() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("RETROCEDIENDO (POTENCIA MAX)");
}

// INVERTIDO: Cuando recibe comando Izquierda, ejecuta pines de giro a la Derecha
void girarIzquierda() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("IZQUIERDA (Giro físico a la Derecha - POTENCIA MAX)");
}

// INVERTIDO: Cuando recibe comando Derecha, ejecuta pines de giro a la Izquierda
void girarDerecha() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("DERECHA (Giro físico a la Izquierda - POTENCIA MAX)");
}

// ===== EVENTOS WIFI =====
void WiFiEvent(WiFiEvent_t event) {
  if (event == ARDUINO_EVENT_WIFI_AP_STADISCONNECTED && WiFi.softAPgetStationNum() == 0) {
    frenarMotores();
  }
}

// ===== RUTAS DEL SERVIDOR WEB =====
void handleAction() {
  if (!server.hasArg("go")) return;
  String cmd = server.arg("go");

  if (cmd == "F") avanzar();
  else if (cmd == "B") retroceder();
  else if (cmd == "L") girarIzquierda();
  else if (cmd == "R") girarDerecha();
  else frenarMotores();

  server.send(200, "text/plain", "OK");
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);
  
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(LED_AZUL, OUTPUT);
  
  frenarMotores();

  WiFi.mode(WIFI_AP);
  WiFi.onEvent(WiFiEvent);
  WiFi.softAPConfig(local_IP, gateway, subnet);
  
  if (WiFi.softAP(ssid, password, wifi_channel, 0, 4)) {
    Serial.println("WiFi Listo: " + String(ssid) + " | IP: " + WiFi.softAPIP().toString());
    for(int i=0; i<3; i++){ digitalWrite(LED_AZUL, HIGH); delay(150); digitalWrite(LED_AZUL, LOW); delay(150); }
  }

  server.on("/", [](){ server.send_P(200, "text/html", html_page); });
  server.on("/action", handleAction);
  server.begin();
}

void loop() {
  server.handleClient();
}
