    if(cmd===curCmd && (Date.now()-lastT < 200)) return;
    curCmd=cmd; lastT=Date.now(); sText.innerText=txt;
    sDot.style.background = (cmd==='S') ? '#35e7ff' : '#b8ff5a';
    sDot.style.boxShadow = (cmd==='S') ? '0 0 10px #35e7ff' : '0 0 12px #b8ff5a';
