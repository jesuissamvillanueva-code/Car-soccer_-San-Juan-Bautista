#include <WiFi.h>
#include <WebServer.h>

// ===== CONFIGURACIÓN WIFI (MODO PUNTO DE ACCESO) =====
const char* ssid = "CAR_sam";
const char* password = "123456789"; // Mínimo 8 caracteres
const int wifi_channel = 6;         // Canal 6 para evitar interferencias

// Configuración de IP Fija
IPAddress local_IP(192, 168, 50, 1);
IPAddress gateway(192, 168, 50, 1);
IPAddress subnet(255, 255, 255, 0);

// ===== SERVIDOR WEB =====
WebServer server(80);

// ===== MOTORES L298N =====
const int IN1 = 16;
const int IN2 = 17;
const int IN3 = 18;
const int IN4 = 19;

// ===== LED DE ESTADO =====
const int LED_AZUL = 2;

// ===== PÁGINA WEB MINIMALISTA (AZUL OSCURO) =====
