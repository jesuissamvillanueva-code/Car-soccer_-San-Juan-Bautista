  function updatePos(cX, cY){
    var r=joy.getBoundingClientRect(), cx=r.width/2, cy=r.height/2;
    var dx=cX-(r.left+cx), dy=cY-(r.top+cy), dist=Math.sqrt(dx*dx+dy*dy), max=r.width*0.35;
