// ===== FUNCIONES DE CONTROL DE MOTORES (L298N) Y DEPURACIÓN =====
void frenarMotores() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, LOW);
  Serial.println("[MOTORES] -> FRENADOS / DETENIDO (IN1:0 IN2:0 IN3:0 IN4:0)");
}

void avanzar() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("[MOTORES] -> AVANZANDO (IN1:1 IN2:0 IN3:1 IN4:0)");
}

void retroceder() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("[MOTORES] -> RETROCEDIENDO (IN1:0 IN2:1 IN3:0 IN4:1)");
}

void girarIzquierda() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("[MOTORES] -> GIRANDO A LA IZQUIERDA (IN1:0 IN2:1 IN3:1 IN4:0)");
}

void girarDerecha() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  digitalWrite(LED_AZUL, HIGH);
  Serial.println("[MOTORES] -> GIRANDO A LA DERECHA (IN1:1 IN2:0 IN3:0 IN4:1)");
}

// ===== EVENTOS WIFI PARA DEPURACIÓN EN TIEMPO REAL =====
void WiFiEvent(WiFiEvent_t event) {
  switch (event) {
    case ARDUINO_EVENT_WIFI_AP_STACONNECTED:
      Serial.print("[WIFI DEBUG] Dispositivo conectado al Car. Total clientes: ");
      Serial.println(WiFi.softAPgetStationNum());
      break;
    case ARDUINO_EVENT_WIFI_AP_STADISCONNECTED:
      Serial.print("[WIFI DEBUG] Dispositivo desconectado. Total clientes: ");
      Serial.println(WiFi.softAPgetStationNum());
      if (WiFi.softAPgetStationNum() == 0) {
        Serial.println("[SEGURIDAD] Ningún celular conectado. Frenando motores automáticamente.");
        frenarMotores();
      }
      break;
    default:
      break;
  }
}

// ===== RUTAS DEL SERVIDOR WEB =====
void handleRoot() {
  Serial.print("[WEB] Cargando interfaz de control en el dispositivo: ");
  Serial.println(server.client().remoteIP());
  server.send_P(200, "text/html", html_page);
}

void handleAction() {
  if (!server.hasArg("go")) {
    server.send(400, "text/plain", "ERROR: Falta parametro go");
    return;
  }

  String cmd = server.arg("go");
  if (cmd == "F") avanzar();
  else if (cmd == "B") retroceder();
  else if (cmd == "L") girarIzquierda();
  else if (cmd == "R") girarDerecha();
  else if (cmd == "S") frenarMotores();
  else frenarMotores();

  server.send(200, "text/plain", "OK:" + cmd);
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("\n==================================================");
  Serial.println("  INICIANDO SISTEMA: CAR SAN JUAN BAUTISTA");
  Serial.println("==================================================");

  // Inicializar Pines L298N
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(LED_AZUL, OUTPUT);

  frenarMotores();
  Serial.println("[OK] Motores frenados por defecto y pines configurados.");

  // Configurar Punto de Acceso con nueva IP Fija (192.168.10.1)
  WiFi.mode(WIFI_AP);
  WiFi.onEvent(WiFiEvent);

  if (WiFi.softAPConfig(local_IP, gateway, subnet)) {
    Serial.println("[OK] Nueva IP Fija 192.168.10.1 asignada correctamente.");
  } else {
    Serial.println("[ERROR] Falló la asignación de IP Fija.");
  }

  if (WiFi.softAP(ssid, password, 1, 0, 4)) {
    Serial.println("[OK] Wi-Fi Punto de Acceso creado exitosamente.");
    Serial.print("     -> Red Wi-Fi (SSID): ");
    Serial.println(ssid);
    Serial.print("     -> Contraseña: ");
    Serial.println(password);
    Serial.print("     -> Entra desde tu navegador a: http://");
    Serial.println(WiFi.softAPIP());

    // 3 parpadeos del LED Azul indicando que el servidor está listo
    for (int i = 0; i < 3; i++) {
      digitalWrite(LED_AZUL, HIGH);
      delay(150);
      digitalWrite(LED_AZUL, LOW);
      delay(150);
    }
  } else {
    Serial.println("[ERROR] No se pudo crear el Wi-Fi.");
  }

  // Rutas principales y rutas directas adicionales de respaldo
  server.on("/", HTTP_GET, handleRoot);
  server.on("/action", HTTP_GET, handleAction);
  server.on("/F", HTTP_GET, []() { avanzar(); server.send(200, "text/plain", "OK"); });
  server.on("/B", HTTP_GET, []() { retroceder(); server.send(200, "text/plain", "OK"); });
  server.on("/L", HTTP_GET, []() { girarIzquierda(); server.send(200, "text/plain", "OK"); });
  server.on("/R", HTTP_GET, []() { girarDerecha(); server.send(200, "text/plain", "OK"); });
  server.on("/S", HTTP_GET, []() { frenarMotores(); server.send(200, "text/plain", "OK"); });

  server.begin();
  Serial.println("[OK] Servidor Web corriendo sin errores.");
  Serial.println("==================================================\n");
}

// ===== LOOP =====
void loop() {
  server.handleClient();
}
