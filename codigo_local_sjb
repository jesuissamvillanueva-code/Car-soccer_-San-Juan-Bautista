<script>
(function() {
  var joystick = document.getElementById('joystick');
  var stick = document.getElementById('stick');
  var statusText = document.getElementById('statusText');
  var statusDot = document.getElementById('statusDot');
  var btnStop = document.getElementById('btnStop');

  var isDragging = false;
  var currentCmd = 'S';
  var lastSentTime = 0;

  // Envía el comando al ESP32 sin bloquear el movimiento de la interfaz
  function enviarComando(cmd, textoEstado, forzar) {
    var ahora = Date.now();
    if (!forzar && cmd === currentCmd && (ahora - lastSentTime < 250)) {
      return;
    }
    currentCmd = cmd;
    lastSentTime = ahora;
    statusText.innerText = textoEstado;

    if (cmd === 'S') {
      statusDot.style.background = '#35e7ff';
      statusDot.style.boxShadow = '0 0 10px #35e7ff';
    } else {
      statusDot.style.background = '#b8ff5a';
      statusDot.style.boxShadow = '0 0 12px #b8ff5a';
    }

    fetch('/action?go=' + cmd, { cache: 'no-store' })
      .then(function(res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
      })
      .catch(function() {
        // Si estás probando el HTML fuera del ESP32, igual mueve el joystick y avisa
        statusDot.style.background = '#ff9800';
      });
  }

  function actualizarPosicion(clientX, clientY) {
    var rect = joystick.getBoundingClientRect();
    var centerX = rect.width / 2;
    var centerY = rect.height / 2;

    var dx = clientX - (rect.left + centerX);
    var dy = clientY - (rect.top + centerY);
    var dist = Math.sqrt(dx * dx + dy * dy);
    var maxDist = rect.width * 0.33; // Radio máximo de movimiento

    if (dist > maxDist) {
      dx = (dx / dist) * maxDist;
      dy = (dy / dist) * maxDist;
    }

    // Mover el botón físicamente usando píxeles exactos (100% compatible con todos los celulares)
    stick.style.left = (centerX + dx) + 'px';
    stick.style.top = (centerY + dy) + 'px';

    var zonaMuerta = rect.width * 0.12;
    if (dist < zonaMuerta) {
      enviarComando('S', 'MOTORES FRENADOS (DETENIDO)', false);
    } else if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 0) {
        enviarComando('R', 'GIRANDO A LA DERECHA ▶', false);
      } else {
        enviarComando('L', '◀ GIRANDO A LA IZQUIERDA', false);
      }
    } else {
      if (dy > 0) {
        enviarComando('B', '▼ RETROCEDIENDO', false);
      } else {
        enviarComando('F', '▲ AVANZANDO', false);
      }
    }
  }

  function centrarYFrenar() {
    isDragging = false;
    stick.classList.remove('active');
    var rect = joystick.getBoundingClientRect();
    stick.style.left = (rect.width / 2) + 'px';
    stick.style.top = (rect.height / 2) + 'px';
    enviarComando('S', 'MOTORES FRENADOS (DETENIDO)', true);
  }

  // ===== EVENTOS TÁCTILES (CELULARES Y TABLETS) =====
  joystick.addEventListener('touchstart', function(e) {
    e.preventDefault();
    isDragging = true;
    stick.classList.add('active');
    var touch = e.touches[0];
    actualizarPosicion(touch.clientX, touch.clientY);
  }, { passive: false });

  window.addEventListener('touchmove', function(e) {
    if (!isDragging) return;
    e.preventDefault();
    var touch = e.touches[0];
    actualizarPosicion(touch.clientX, touch.clientY);
  }, { passive: false });

  window.addEventListener('touchend', function(e) {
    if (!isDragging) return;
    centrarYFrenar();
  });

  window.addEventListener('touchcancel', function(e) {
    if (!isDragging) return;
    centrarYFrenar();
  });

  // ===== EVENTOS DE MOUSE (PC / LAPTOP) =====
  joystick.addEventListener('mousedown', function(e) {
    e.preventDefault();
    isDragging = true;
    stick.classList.add('active');
    actualizarPosicion(e.clientX, e.clientY);
  });

  window.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    actualizarPosicion(e.clientX, e.clientY);
  });

  window.addEventListener('mouseup', function() {
    if (!isDragging) return;
    centrarYFrenar();
  });

  // ===== BOTÓN DE FRENO DE EMERGENCIA =====
  btnStop.addEventListener('touchstart', function(e) {
    e.preventDefault();
    centrarYFrenar();
  }, { passive: false });

  btnStop.addEventListener('click', function() {
    centrarYFrenar();
  });

  // ===== SOPORTE PARA TECLADO (FLECHAS / WASD) =====
  window.addEventListener('keydown', function(e) {
    var rect = joystick.getBoundingClientRect();
    var cx = rect.left + rect.width / 2;
    var cy = rect.top + rect.height / 2;
    var offset = 75;
    if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
      stick.classList.add('active');
      actualizarPosicion(cx, cy - offset);
    } else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
      stick.classList.add('active');
      actualizarPosicion(cx, cy + offset);
    } else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
      stick.classList.add('active');
      actualizarPosicion(cx - offset, cy);
    } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
      stick.classList.add('active');
      actualizarPosicion(cx + offset, cy);
    } else if (e.key === ' ') {
      centrarYFrenar();
    }
  });

  window.addEventListener('keyup', function(e) {
    if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','w','a','s','d','W','A','S','D'].indexOf(e.key) !== -1) {
      centrarYFrenar();
    }
  });

  window.addEventListener('resize', function() {
    if (!isDragging) {
      var rect = joystick.getBoundingClientRect();
      stick.style.left = (rect.width / 2) + 'px';
      stick.style.top = (rect.height / 2) + 'px';
    }
  });
})();
</script>
